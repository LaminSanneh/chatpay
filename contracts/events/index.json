  { "file": "settlement.completed.refund.json",      "exchange": "wallet.events", "routingKey": "settlement.completed", "producer": "wallet-service", "consumers": ["store-backend"], "note": "escrow returned to the buyer" },
  { "file": "store.opened.json",                     "exchange": "store.events",  "routingKey": "store.opened",         "producer": "store-backend",  "consumers": ["chat-service"], "note": "also sent when an active store is renamed" },
