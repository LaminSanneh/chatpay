PORT=4000
CORS_ORIGINS=http://localhost:3000
# JWT validation (Keycloak). JWKS defaults to <issuer>/protocol/openid-connect/certs
OIDC_ISSUER=http://localhost:8080/realms/chatpay
# Postgres (docker compose service chat-db). Leave empty to use in-memory storage.
DATABASE_URL=postgres://chat:chat@localhost:5434/chat
# Events (RabbitMQ). Leave empty to run chat without payment bubbles and store icons.
AMQP_URL=amqp://chatpay:chatpay@localhost:5672
WALLET_EVENTS_EXCHANGE=wallet.events
CHAT_WALLET_QUEUE=chat.wallet-events
STORE_EVENTS_EXCHANGE=store.events
CHAT_STORE_QUEUE=chat.store-events
