{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "amqplib": [
        "node_modules/@types/amqplib"
      ]
    }
  },
  "include": [
    "src",
    "tests",
    "../../mock-services/amqp/**/*.ts"
  ]
}
