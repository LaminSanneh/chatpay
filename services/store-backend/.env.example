APP_NAME="ChatPay Store"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5435
DB_DATABASE=store
DB_USERNAME=store
DB_PASSWORD=store

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=public

# Keycloak (same realm as chat and wallet)
OIDC_ISSUER=http://localhost:8080/realms/chatpay
# Back office login (confidential client "laravel-admin")
KEYCLOAK_ADMIN_CLIENT_ID=laravel-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=dev-laravel-admin-secret
# Service account used to talk to the wallet (client "laravel-service", role wallet-merchant)
WALLET_URL=http://localhost:8081
WALLET_CLIENT_ID=laravel-service
WALLET_CLIENT_SECRET=dev-laravel-secret

# Events (RabbitMQ)
AMQP_HOST=127.0.0.1
AMQP_PORT=5672
AMQP_USER=chatpay
AMQP_PASSWORD=chatpay

CORS_ORIGINS=http://localhost:3000,http://localhost:3001
STORE_WEB_URL=http://localhost:3001

# Retry policy for the wallet-events consumer (defaults shown): backoff 2s, 4s, 8s, 16s, 30s, then dead-letter
# STORE_RETRY_INITIAL_MS=2000
# STORE_RETRY_MULTIPLIER=2
# STORE_RETRY_MAX_MS=30000
# STORE_RETRY_MAX_ATTEMPTS=5
